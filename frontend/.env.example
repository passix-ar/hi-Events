# In a non development environment these would usually be the same
VITE_API_URL_CLIENT=https://localhost:8443/api
VITE_API_URL_SERVER=http://backend:8080

VITE_FRONTEND_URL=https://localhost:8443
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51Ofu1CJKnXOyGeQuDPUHiZcJxZozRuERiv4vQRBtCscwTbxOL574cxUjAoNRL2YLCumgC5160pl6kvTIiAc9mOeM0058KAWQ55

# Cloudflare Turnstile (anti-bot CAPTCHA on the public checkout). Disabled by default.
# Test site key "1x00000000000000000000AA" always passes. Must match TURNSTILE_ENABLED on the backend.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Sign in with Google. Disabled by default.
# The client ID is public; there is no secret in the ID token flow.
# Must match GOOGLE_AUTH_ENABLED / GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
