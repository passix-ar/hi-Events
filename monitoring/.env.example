# Copiar a .env y completar antes de levantar el stack
# cp .env.example .env

# Contraseña del panel Grafana (admin / este-valor)
GRAFANA_PASSWORD=cambia-esto-ahora

# Dominio donde va a estar expuesto Grafana (Coolify lo gestiona)
GRAFANA_DOMAIN=grafana.getpassix.com

# URL pública del app — blackbox la monitorea cada 30s
APP_URL=https://app.getpassix.com
